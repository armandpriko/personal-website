---
const navItems = [
  { href: '/', label: 'Accueil', icon: 'house' },
  { href: '/experience', label: 'Expérience', icon: 'briefcase' },
  { href: '/projets', label: 'Projets', icon: 'code' },
  { href: '/achievements', label: 'Réalisations', icon: 'trophy' },
  { href: '/certifications', label: 'Certifications', icon: 'medal' },
  { href: '/competences', label: 'Compétences', icon: 'brain' },
  { href: '/contact', label: 'Contact', icon: 'envelope-simple' }
];
---

<nav class="fixed top-0 left-0 right-0 bg-neutral-100 dark:bg-neutral-900 border-b dark:border-neutral-800 z-40 backdrop-blur-sm">
  <div class="container mx-auto py-2 sm:py-3">
    <div class="flex justify-center">
      <div class="flex space-x-1 sm:space-x-3 md:space-x-6 overflow-x-auto">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="flex items-center space-x-1 sm:space-x-2 px-2 sm:px-3 md:px-4 py-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800 whitespace-nowrap"
          >
            <i class={`ph ph-${item.icon} text-sm sm:text-base md:text-lg`}></i>
            <span class="text-xs sm:text-sm font-medium hidden sm:inline">{item.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>
