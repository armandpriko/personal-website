---
import '@phosphor-icons/web/regular/style.css';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio de Dzudzogbe Prince Armand Koumi' } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="author" content="Dzudzogbe Prince Armand Koumi" />
    <meta name="keywords" content="Data Scientist, Machine Learning, Agriculture de précision, Télédétection, Agro-économie, Python, R, QGIS, Madagascar, France, Togo" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="fr" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://armandkoumi.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://armandkoumi.github.io/images/armand-profile.jpg" />
    <meta property="og:site_name" content="Dzudzogbe Prince Armand Koumi - Portfolio" />
    <meta property="og:locale" content="fr_FR" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://armandkoumi.github.io/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://armandkoumi.github.io/images/armand-profile.jpg" />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#10b981" />
    <meta name="msapplication-TileColor" content="#10b981" />
    
    <!-- Mobile App Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Portfolio Armand" />
    
    <!-- PWA Support -->
    <meta name="application-name" content="Portfolio Armand" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dzudzogbe Prince Armand Koumi",
      "jobTitle": "Data Scientist en agriculture, agro-alimentaire et environnement",
      "description": "Spécialisé en agriculture, environnement et agroalimentaire, je mobilise ma triple compétence en agronomie, statistique et informatique pour développer des outils d'aide à la décision.",
      "url": "https://armandkoumi.github.io/",
      "image": "https://armandkoumi.github.io/images/armand-profile.jpg",
      "email": "koumiprince@gmail.com",
      "telephone": "+33 6 02 89 23 54",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Paris",
        "addressCountry": "France"
      },
      "alumniOf": [
        "Institut Polytechnique UniLaSalle Rouen",
        "École Normale Supérieure (ENS-PSL)",
        "Université de Lomé"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Fondation pour les Aires Protégées et de la Biodiversité de Madagascar (FAPBM)"
      },
      "knowsAbout": [
        "Machine Learning",
        "Data Science",
        "Agriculture de précision",
        "Télédétection",
        "Python",
        "R",
        "QGIS"
      ],
              "sameAs": [
                "https://www.linkedin.com/in/dzudzogbe-prince-armand-koumi",
                "https://github.com/armandpriko",
                "https://www.youtube.com/@Ddexplora",
                "https://www.researchgate.net/profile/Dzudzogbe-Koumi-2"
              ]
    }
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.0.3/src/regular/style.css" rel="stylesheet">
    
    <!-- Google Translate Script -->
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({
          pageLanguage: 'fr',
          includedLanguages: 'en,es,de,it,pt,ru,zh,ja,ko,ar',
          layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false
        }, 'google_translate_element');
      }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
    <!-- Custom CSS for Google Translate Widget -->
    <style>
      /* Completely hide Google Translate banner and branding */
      .goog-te-banner-frame.skiptranslate {
        display: none !important;
      }
      
      body {
        top: 0 !important;
      }
      
      /* Hide Google branding completely */
      .goog-te-gadget-simple .goog-te-menu-value span:first-child {
        display: none !important;
      }
      
      /* Hide the Google logo and text */
      .goog-te-gadget-simple {
        background: none !important;
        border: none !important;
        font-size: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
      }
      
      /* Custom language selector styling */
      .goog-te-gadget-simple .goog-te-menu-value {
        display: flex !important;
        align-items: center !important;
        padding: 8px 12px !important;
        background-color: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important;
        color: #475569 !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      
      .dark .goog-te-gadget-simple .goog-te-menu-value {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #cbd5e1 !important;
      }
      
      .goog-te-gadget-simple .goog-te-menu-value:hover {
        background-color: #e2e8f0 !important;
        border-color: #cbd5e1 !important;
      }
      
      .dark .goog-te-gadget-simple .goog-te-menu-value:hover {
        background-color: #334155 !important;
        border-color: #475569 !important;
      }
      
      /* Custom flag and language code display */
      .goog-te-gadget-simple .goog-te-menu-value:before {
        content: "🇫🇷" !important;
        margin-right: 8px !important;
        font-size: 16px !important;
      }
      
      .goog-te-gadget-simple .goog-te-menu-value:after {
        content: "Français" !important;
        flex: 1 !important;
        text-align: left !important;
      }
      
      /* Add dropdown arrow */
      .goog-te-gadget-simple .goog-te-menu-value span:last-child:after {
        content: "▼" !important;
        margin-left: auto !important;
        font-size: 10px !important;
        color: #64748b !important;
      }
      
      /* Style the dropdown menu */
      .goog-te-menu {
        background-color: white !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        max-height: 300px !important;
        overflow-y: auto !important;
        z-index: 1000 !important;
        margin-top: 4px !important;
      }
      
      .dark .goog-te-menu {
        background-color: #1e293b !important;
        border-color: #334155 !important;
      }
      
      /* Style dropdown items */
      .goog-te-menu-item {
        padding: 10px 12px !important;
        border-bottom: 1px solid #f1f5f9 !important;
        transition: background-color 0.2s ease !important;
        display: flex !important;
        align-items: center !important;
      }
      
      .dark .goog-te-menu-item {
        border-bottom-color: #334155 !important;
      }
      
      .goog-te-menu-item:hover {
        background-color: #f8fafc !important;
      }
      
      .dark .goog-te-menu-item:hover {
        background-color: #334155 !important;
      }
      
      /* Hide the "Original" option */
      .goog-te-menu-item:first-child {
        display: none !important;
      }
      
      /* Style language text in dropdown */
      .goog-te-menu-item .goog-te-menu-item-text {
        color: #475569 !important;
        font-family: inherit !important;
        font-size: 14px !important;
        font-weight: 500 !important;
      }
      
      .dark .goog-te-menu-item .goog-te-menu-item-text {
        color: #cbd5e1 !important;
      }
      
      /* Add flags to dropdown items */
      .goog-te-menu-item[value="en"] .goog-te-menu-item-text:before {
        content: "🇺🇸 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="es"] .goog-te-menu-item-text:before {
        content: "🇪🇸 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="de"] .goog-te-menu-item-text:before {
        content: "🇩🇪 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="it"] .goog-te-menu-item-text:before {
        content: "🇮🇹 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="pt"] .goog-te-menu-item-text:before {
        content: "🇵🇹 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="ru"] .goog-te-menu-item-text:before {
        content: "🇷🇺 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="zh"] .goog-te-menu-item-text:before {
        content: "🇨🇳 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="ja"] .goog-te-menu-item-text:before {
        content: "🇯🇵 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="ko"] .goog-te-menu-item-text:before {
        content: "🇰🇷 " !important;
        margin-right: 8px !important;
      }
      
      .goog-te-menu-item[value="ar"] .goog-te-menu-item-text:before {
        content: "🇸🇦 " !important;
        margin-right: 8px !important;
      }
    </style>
  </head>
  <body class="bg-neutral-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50 font-sans antialiased selection:bg-green-500 selection:text-white transition-colors duration-300">
    <div id="app" class="min-h-screen">
      <!-- Top Navigation Bar -->
      <Navigation />
      
            <!-- Main Content -->
            <main class="pt-16 sm:pt-20">
              <slot />
            </main>
      
      <!-- Top Right Controls -->
      <div class="fixed top-2 right-2 sm:top-4 sm:right-4 z-50 flex gap-2 sm:gap-3">
        <!-- CV Dropdown Menu -->
        <div class="relative group">
          <button class="bg-green-600 hover:bg-green-700 text-white px-3 py-2 sm:px-4 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 shadow-lg hover:shadow-xl flex items-center">
            <i class="ph ph-download mr-1 sm:mr-2"></i>
            <span class="hidden sm:inline">CV</span>
            <i class="ph ph-caret-down ml-1 text-xs"></i>
          </button>
          
          <!-- Dropdown Menu -->
          <div class="absolute right-0 top-full mt-2 w-48 bg-white dark:bg-neutral-800 rounded-lg shadow-xl border border-neutral-200 dark:border-neutral-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <div class="py-2">
              <a href="https://cvdesignr.com/p/683580e517ed8" target="_blank" 
                 class="flex items-center px-4 py-3 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-green-50 dark:hover:bg-green-900 hover:text-green-700 dark:hover:text-green-300 transition-colors">
                <i class="ph ph-flag mr-3 text-blue-500"></i>
                <div>
                  <div class="font-medium">CV en Français</div>
                  <div class="text-xs text-neutral-500 dark:text-neutral-400">Version française</div>
                </div>
              </a>
              <a href="https://cvdesignr.com/p/68f20c7b50c54" target="_blank" 
                 class="flex items-center px-4 py-3 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-green-50 dark:hover:bg-green-900 hover:text-green-700 dark:hover:text-green-300 transition-colors">
                <i class="ph ph-flag mr-3 text-red-500"></i>
                <div>
                  <div class="font-medium">CV in English</div>
                  <div class="text-xs text-neutral-500 dark:text-neutral-400">English version</div>
                </div>
              </a>
            </div>
          </div>
        </div>
        <!-- Translation Button -->
        <div class="relative group">
          <button id="translate-btn" class="bg-blue-600 hover:bg-blue-700 text-white p-2 sm:p-3 rounded-full transition-colors shadow-lg hover:shadow-xl">
            <i class="ph ph-translate text-lg sm:text-xl"></i>
          </button>
          
          <!-- Translate Dropdown -->
          <div id="translate-dropdown" class="absolute right-0 top-full mt-2 w-48 bg-white dark:bg-neutral-800 rounded-lg shadow-xl border border-neutral-200 dark:border-neutral-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <div class="p-2">
              <div class="text-xs text-neutral-500 dark:text-neutral-400 mb-2 px-2">Traduire cette page</div>
              <div id="google_translate_element"></div>
            </div>
          </div>
        </div>
        
        <button id="theme-toggle" class="bg-neutral-200 dark:bg-neutral-800 p-2 sm:p-3 rounded-full hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors shadow-lg hover:shadow-xl">
          <i id="theme-icon" class="ph ph-moon-stars text-lg sm:text-xl text-neutral-700 dark:text-neutral-300"></i>
        </button>
      </div>
    </div>
    <script is:inline>
      function setTheme(theme) {
        const html = document.documentElement;
        if (theme === 'dark') {
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        } else {
          html.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        }
        updateThemeIcon();
      }

      function updateThemeIcon() {
        const themeIcon = document.getElementById('theme-icon');
        if (themeIcon) {
          if (document.documentElement.classList.contains('dark')) {
            themeIcon.className = 'ph ph-sun text-xl text-yellow-400';
          } else {
            themeIcon.className = 'ph ph-moon-stars text-xl text-neutral-700';
          }
        }
      }

      function initTheme() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (savedTheme === 'dark' || (!savedTheme && prefersDarkMode)) {
          setTheme('dark');
        } else {
          setTheme('light');
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        initTheme();
        
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            setTheme(isDark ? 'light' : 'dark');
          });
        }
      });

      // Also listen for astro page loads
      document.addEventListener('astro:page-load', () => {
        initTheme();
        
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          // Remove existing listeners to avoid duplicates
          themeToggle.replaceWith(themeToggle.cloneNode(true));
          const newToggle = document.getElementById('theme-toggle');
          newToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            setTheme(isDark ? 'light' : 'dark');
          });
        }

        // Translation functionality
        const translateBtn = document.getElementById('translate-btn');
        const translateDropdown = document.getElementById('translate-dropdown');
        
        if (translateBtn && translateDropdown) {
          translateBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            translateDropdown.classList.toggle('opacity-0');
            translateDropdown.classList.toggle('invisible');
            translateDropdown.classList.toggle('opacity-100');
            translateDropdown.classList.toggle('visible');
          });

          // Close dropdown when clicking outside
          document.addEventListener('click', (e) => {
            if (!translateBtn.contains(e.target) && !translateDropdown.contains(e.target)) {
              translateDropdown.classList.add('opacity-0', 'invisible');
              translateDropdown.classList.remove('opacity-100', 'visible');
            }
          });
        }

        // Hide Google Translate banner completely
        const hideGoogleBanner = () => {
          // Remove Google Translate banner
          const banner = document.querySelector('.goog-te-banner-frame');
          if (banner) {
            banner.style.display = 'none';
            banner.remove();
          }
          
          // Remove top margin/padding added by Google Translate
          document.body.style.top = '0';
          document.documentElement.style.top = '0';
          
          // Hide Google branding
          const googleBranding = document.querySelector('.goog-te-gadget-simple .goog-te-menu-value span:first-child');
          if (googleBranding) {
            googleBranding.style.display = 'none';
          }
          
          // Remove Google logo
          const googleLogo = document.querySelector('.goog-te-gadget-simple img');
          if (googleLogo) {
            googleLogo.style.display = 'none';
          }
        };

        // Run immediately and on page changes
        hideGoogleBanner();
        
        // Hide banner when Google Translate loads
        const observer = new MutationObserver(() => {
          hideGoogleBanner();
        });
        
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
    opacity: 1;
  }

  html {
    font-family: 'Inter', sans-serif;
    scroll-behavior: smooth;
  }
</style>
