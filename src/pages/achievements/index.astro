---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';

const achievements = [
  {
    title: "Top 30 des jeunes Africains de l'AIIB 2022",
    organization: "UNDP Égypte",
    date: "Octobre 2022",
    category: "Reconnaissance Internationale",
    description: "Sélectionné parmi les 30 jeunes africains les plus prometteurs par l'African Infrastructure Investment Bank (AIIB) et le Programme des Nations Unies pour le Développement (PNUD). Cette reconnaissance souligne mon engagement pour l'innovation et le développement durable en Afrique.",
    icon: "trophy",
    type: "award",
    impact: "Reconnaissance internationale de l'expertise en développement durable",
    link: "#"
  },
  {
    title: "Top 30 des jeunes Togolais pour le Maker's Activity Program",
    organization: "Ambassade des États-Unis au Togo",
    date: "Mai 2023",
    category: "Innovation & Entrepreneuriat",
    description: "Sélectionné parmi les 30 jeunes togolais les plus innovants pour participer au Maker's Activity Program. Ce programme vise à promouvoir l'entrepreneuriat et l'innovation technologique au Togo.",
    icon: "lightbulb",
    type: "program",
    impact: "Promotion de l'innovation technologique au Togo",
    link: "#"
  },
  {
    title: "Lauréat du concours régional Afrique de l'Ouest (prix JVF)",
    organization: "OIF & Ecolotrip",
    date: "Novembre 2023",
    category: "Développement Durable",
    description: "Vainqueur du concours régional Afrique de l'Ouest dans la catégorie Jeunes Volontaires Francophones (JVF). Ce prix récompense les initiatives innovantes en matière de développement durable et d'engagement communautaire.",
    icon: "leaf",
    type: "competition",
    impact: "Promotion des solutions durables en Afrique de l'Ouest",
    link: "#"
  },
  {
    title: "Lauréat de la bourse de stage du UICN PAPACO",
    organization: "UICN PAPACO, FFEM et Université Senghor",
    date: "2023",
    category: "Conservation & Biodiversité",
    description: "Bénéficiaire de la prestigieuse bourse de stage offerte par l'UICN PAPACO (Programme d'Appui aux Aires Protégées d'Afrique Centrale et de l'Ouest), le FFEM (Fonds Français pour l'Environnement Mondial) et l'Université Senghor en Égypte. Cette bourse a financé ma formation en conservation des aires protégées.",
    icon: "tree",
    type: "scholarship",
    impact: "Formation spécialisée en conservation de la biodiversité",
    link: "#"
  },
  {
    title: "Major de promotion - MSc Gestion des données agricoles et alimentaires",
    organization: "Institut Polytechnique UniLaSalle Rouen",
    date: "Septembre 2024 - Septembre 2025",
    category: "Excellence Académique",
    description: "Major de la promotion 7 du Master en Gestion des données agricoles et alimentaires à UniLaSalle Rouen. Cette distinction récompense l'excellence académique et l'engagement dans les projets de recherche en agriculture de précision.",
    icon: "graduation-cap",
    type: "academic",
    impact: "Excellence académique reconnue dans le domaine agricole",
    link: "#"
  },
  {
    title: "Machine Learning Mentor - EcoHackathon 2024",
    organization: "GainForest-ETH AI Center Zurich",
    date: "Mai 2024 - Juin 2024",
    category: "Mentorat & Leadership",
    description: "Mentor en Machine Learning pour l'EcoHackathon 2024 organisé par GainForest et l'ETH AI Center de Zurich. Supervision d'équipes, évaluation de projets, support technique et analyse de données environnementales pour la gestion durable des forêts.",
    icon: "users",
    type: "volunteer",
    impact: "Formation et accompagnement de jeunes talents en IA environnementale",
    link: "#"
  }
];

const publications = [
  {
    title: "Utilisation de la spectroscopie proche infrarouge pour développer des modèles prédictifs des indicateurs bio-physico-chimiques de la qualité du sol",
    authors: "Koumi, D.P.A., Dhar, B.",
    year: "2025",
    type: "Rapport de recherche",
    publisher: "UniLaSalle - AGHYLE",
    description: "Rapport interne présentant les résultats de recherche sur l'utilisation de la spectroscopie NIRS pour la prédiction des propriétés du sol. Développement de modèles chimiométriques avancés pour l'évaluation rapide de la qualité du sol.",
    icon: "file-text",
    link: "#"
  },
  {
    title: "Analyse des effets de l'agriculture conventionnelle et de l'agriculture de conservation sur la santé des sols en climat méditerranéen : une approche combinant modélisation mécaniste et Machine Learning causal",
    authors: "Koumi, D.P.A.",
    year: "2025",
    type: "Mémoire de Master",
    publisher: "ENS - Projet PRIMA Sharing-MED",
    description: "Mémoire de recherche combinant approches de modélisation mécaniste (RothC, Century) et techniques de Machine Learning causal pour analyser l'impact des pratiques agricoles sur la santé des sols en climat méditerranéen.",
    icon: "book",
    link: "#"
  }
];
---

<MainLayout title="Réalisations & Publications - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-6xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Réalisations & Publications
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Découvrez mes reconnaissances, awards et contributions scientifiques
      </p>
    </section>

    <!-- Achievements Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-trophy mr-3 text-yellow-500"></i>
        Réalisations & Distinctions
      </h2>
      
      <div class="grid lg:grid-cols-2 gap-8">
        {achievements.map((achievement, index) => (
          <div class="achievement-card bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300 hover:transform hover:scale-105 border-l-4 border-green-500">
            <!-- Achievement Header -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-start">
                <div class="bg-gradient-to-br from-green-500 to-blue-600 p-3 rounded-lg mr-4">
                  <i class={`ph ph-${achievement.icon} text-2xl text-white`}></i>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-1">
                    {achievement.title}
                  </h3>
                  <p class="text-sm text-neutral-500 mb-2">{achievement.organization}</p>
                  <span class={`inline-block px-3 py-1 rounded-full text-xs font-medium ${
                    achievement.type === 'award' ? 'bg-yellow-900 text-yellow-300' :
                    achievement.type === 'program' ? 'bg-blue-900 text-blue-300' :
                    achievement.type === 'competition' ? 'bg-green-900 text-green-300' :
                    achievement.type === 'scholarship' ? 'bg-purple-900 text-purple-300' :
                    achievement.type === 'academic' ? 'bg-indigo-900 text-indigo-300' :
                    'bg-orange-900 text-orange-300'
                  }`}>
                    {achievement.category}
                  </span>
                </div>
              </div>
              <span class="text-sm text-neutral-500 font-medium">{achievement.date}</span>
            </div>

            <!-- Achievement Description -->
            <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
              {achievement.description}
            </p>

            <!-- Impact -->
            <div class="bg-neutral-200 dark:bg-neutral-800 p-3 rounded-lg mb-4">
              <div class="flex items-center">
                <i class="ph ph-target mr-2 text-green-500"></i>
                <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Impact :</span>
                <span class="text-sm text-neutral-600 dark:text-neutral-400 ml-2">{achievement.impact}</span>
              </div>
            </div>

            <!-- Action Button -->
            <div class="flex justify-end">
              <a href={achievement.link} class="text-green-500 hover:text-green-400 text-sm font-medium flex items-center">
                En savoir plus <i class="ph ph-arrow-right ml-1"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Publications Section -->
    <section>
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-book-open mr-3 text-blue-500"></i>
        Publications & Articles
      </h2>
      
      <div class="space-y-6">
        {publications.map((pub, index) => (
          <div class="publication-card bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300">
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-blue-500 to-purple-600 p-3 rounded-lg mr-6">
                <i class={`ph ph-${pub.icon} text-2xl text-white`}></i>
              </div>
              
              <div class="flex-1">
                <!-- Publication Header -->
                <div class="flex justify-between items-start mb-3">
                  <div>
                    <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                      {pub.title}
                    </h3>
                    <p class="text-sm text-neutral-500 mb-2">{pub.authors}</p>
                    <div class="flex items-center gap-4 text-sm text-neutral-600 dark:text-neutral-400">
                      <span class="flex items-center">
                        <i class="ph ph-calendar mr-1"></i>
                        {pub.year}
                      </span>
                      <span class="flex items-center">
                        <i class="ph ph-file mr-1"></i>
                        {pub.type}
                      </span>
                      <span class="flex items-center">
                        <i class="ph ph-building mr-1"></i>
                        {pub.publisher}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Description -->
                <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
                  {pub.description}
                </p>

                <!-- Action Buttons -->
                <div class="flex gap-3">
                  <a href={pub.link} class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm transition flex items-center">
                    <i class="ph ph-file-text mr-2"></i>
                    Lire le document
                  </a>
                  <button class="bg-neutral-700 hover:bg-neutral-800 text-white px-4 py-2 rounded-lg text-sm transition flex items-center">
                    <i class="ph ph-citation mr-2"></i>
                    Citer
                  </button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Statistics Section -->
    <section class="mt-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-chart-bar mr-3 text-green-500"></i>
        En quelques chiffres
      </h2>
      
      <div class="grid md:grid-cols-4 gap-6">
        <div class="stat-card bg-gradient-to-br from-green-500 to-green-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">6</div>
          <div class="text-sm opacity-90">Distinctions & Awards</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">2</div>
          <div class="text-sm opacity-90">Publications</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">4</div>
          <div class="text-sm opacity-90">Pays d'impact</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">3</div>
          <div class="text-sm opacity-90">Domaines d'expertise</div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer for cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe achievement cards
    const achievementCards = document.querySelectorAll('.achievement-card');
    achievementCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe publication cards
    const publicationCards = document.querySelectorAll('.publication-card');
    publicationCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .achievement-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .publication-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .stat-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }
</style>
