---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';

const achievements = [
  // Publications
  {
    title: "Perceptions and adaptation strategies of cereal farmers (rice and maize) to the impacts of natural hazards in the Maritime Region of Togo",
    type: "publication",
    category: "research",
    date: "2024",
    description: "Une étude de cas sur les poches de sécheresse et les inondations dans la région maritime du Togo, analysant les stratégies d'adaptation des producteurs de céréales face aux catastrophes naturelles.",
    link: "https://www.researchgate.net/publication/396194173_Perceptions_and_adaptation_strategies_of_cereal_farmers_rice_and_maize_to_the_impacts_of_natural_hazards_in_the_Maritime_Region_of_Togo_a_case_study_of_drought_pockets_and_floods",
    image: "/images/achievements/togo-farmers-study.png",
    icon: "file-text",
    tags: ["Agriculture", "Climate Change", "Adaptation Strategies", "Togo"],
    journal: "ResearchGate Publication"
  },
  {
    title: "Analyse des effets de l'agriculture conventionnelle et de l'agriculture de conservation sur la santé des sols en climat méditerranéen",
    type: "publication",
    category: "research",
    date: "2024",
    description: "Une approche combinant modélisation mécaniste et Machine Learning pour analyser l'impact des pratiques agricoles sur la santé des sols en climat méditerranéen.",
    link: "https://www.researchgate.net/publication/396155201_Analyse_des_effets_de_l'agriculture_conventionnelle_et_de_l'agriculture_de_conservation_sur_la_sante_des_sols_en_climat_mediterraneen_une_approche_combinant_modelisation_mecaniste_et_Machine_Learning_",
    image: "/images/achievements/soil-health-analysis.png",
    icon: "flask",
    tags: ["Soil Science", "Machine Learning", "Conservation Agriculture", "Mediterranean Climate"],
    journal: "Mémoire de Recherche"
  },

  // Projets Master - Dashboards
  {
    title: "Dashboard de Suivi des Aires Protégées - FAPBM",
    type: "project",
    category: "dashboard",
    date: "2025",
    description: "Tableau de bord interactif pour le suivi en temps réel des indicateurs de performance des aires protégées de Madagascar. Intégration de données multisources et visualisations dynamiques.",
    link: null,
    image: "/images/achievements/fapbm-dashboard.png",
    icon: "chart-bar",
    tags: ["Power BI", "Data Visualization", "Conservation", "KPI Dashboard"],
    technologies: ["Power BI", "Python", "SQL", "Azure"]
  },
  {
    title: "Dashboard d'Analyse des Sols - UniLaSalle",
    type: "project",
    category: "dashboard",
    date: "2025",
    description: "Interface d'analyse des données de spectroscopie NIRS pour la prédiction des propriétés du sol. Visualisation interactive des modèles prédictifs et métriques de performance.",
    link: null,
    image: "/images/achievements/soil-dashboard.png",
    icon: "leaf",
    tags: ["NIRS Analysis", "Soil Prediction", "Machine Learning", "Data Science"],
    technologies: ["R Shiny", "Python", "Machine Learning", "NIRS"]
  },

  // Projets Master - Rapports Analytiques
  {
    title: "Rapport d'Analyse Environnementale - Bassin du Congo",
    type: "project",
    category: "report",
    date: "2024",
    description: "Rapport complet d'analyse de la déforestation dans le Bassin du Congo utilisant l'imagerie satellite Sentinel-2 et des algorithmes de deep learning. Méthodologie et résultats détaillés.",
    link: null,
    image: "/images/achievements/congo-deforestation-report.png",
    icon: "tree",
    tags: ["Remote Sensing", "Deforestation", "Deep Learning", "Congo Basin"],
    technologies: ["Python", "TensorFlow", "Sentinel-2", "QGIS"]
  },
  {
    title: "Rapport de Modélisation des Sols - Climat Méditerranéen",
    type: "project",
    category: "report",
    date: "2025",
    description: "Rapport technique sur la modélisation de la santé des sols en climat méditerranéen. Intégration de données LUCAS, SoilGrids et satellites avec validation des modèles.",
    link: null,
    image: "/images/achievements/soil-modeling-report.png",
    icon: "file-chart",
    tags: ["Soil Modeling", "Machine Learning", "Climate", "Data Integration"],
    technologies: ["R", "Python", "RothC", "Century", "LUCAS"]
  },

  // Certifications & Récompenses
  {
    title: "Major de Promotion MSc. AFDM - UniLaSalle",
    type: "achievement",
    category: "academic",
    date: "2025",
    description: "Diplôme de major de promotion du Master Sciences en Agriculture, Forêt, Développement Durable et Métiers de l'Environnement (AFDM) à UniLaSalle.",
    link: null,
    image: "/images/achievements/major-promotion.png",
    icon: "graduation-cap",
    tags: ["Academic Excellence", "Leadership", "Agriculture", "Environment"],
    technologies: []
  },
  {
    title: "Ambassadeur Promotion UniLaSalle",
    type: "achievement",
    category: "leadership",
    date: "2024",
    description: "Reconnaissance en tant qu'ambassadeur de promotion pour l'engagement étudiant et la réalisation de projets innovants.",
    link: null,
    image: "/images/achievements/ambassador.png",
    icon: "medal",
    tags: ["Leadership", "Student Engagement", "Project Management"],
    technologies: []
  },

  // Challenges & Compétitions
  {
    title: "Microsoft Learn Location Mention Recognition Challenge",
    type: "achievement",
    category: "competition",
    date: "2024",
    description: "Participation au challenge Microsoft de reconnaissance automatique de mentions de lieux dans les posts de microblogging. Classé 77/320 (Top 25%).",
    link: "https://zindi.africa/competitions/microsoft-learn-location-mention-recognition-challenge",
    image: "/images/achievements/location-recognition-challenge.png",
    icon: "map-pin",
    tags: ["NLP", "Machine Learning", "Microsoft", "Zindi"],
    technologies: ["Python", "NLP", "Machine Learning", "Location Recognition"]
  },
  {
    title: "Togo Fiber Optics Uptake Prediction Challenge",
    type: "achievement",
    category: "competition",
    date: "2024",
    description: "Participation au challenge de prédiction d'adoption de la fibre optique au Togo. Classé 30/93 (Top 50%) avec impact sur les politiques publiques.",
    link: "https://zindi.africa/competitions/togo-fiber-optics-uptake-prediction-challenge",
    image: "/images/achievements/fiber-optics-challenge.png",
    icon: "wifi-high",
    tags: ["Prediction", "Telecom", "Public Policy", "Togo"],
    technologies: ["Python", "Machine Learning", "Prediction", "Socio-demographic Analysis"]
  }
];

// Pagination settings
const achievementsPerPage = 6;
const totalPages = Math.ceil(achievements.length / achievementsPerPage);
---

<MainLayout title="Réalisations & Publications - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-7xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Réalisations & Publications
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Mes projets de recherche, publications, dashboards et rapports analytiques réalisés durant mon master
      </p>
    </section>

    <!-- Filter Tabs -->
    <section class="mb-12">
      <div class="flex flex-wrap justify-center gap-4">
        <button onclick="filterAchievements('all')" class="filter-btn active px-6 py-3 rounded-full bg-green-600 text-white font-medium transition-all">
          Toutes
        </button>
        <button onclick="filterAchievements('publication')" class="filter-btn px-6 py-3 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-medium transition-all hover:bg-green-500 hover:text-white">
          Publications
        </button>
        <button onclick="filterAchievements('dashboard')" class="filter-btn px-6 py-3 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-medium transition-all hover:bg-green-500 hover:text-white">
          Dashboards
        </button>
        <button onclick="filterAchievements('report')" class="filter-btn px-6 py-3 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-medium transition-all hover:bg-green-500 hover:text-white">
          Rapports
        </button>
        <button onclick="filterAchievements('achievement')" class="filter-btn px-6 py-3 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-medium transition-all hover:bg-green-500 hover:text-white">
          Récompenses
        </button>
      </div>
    </section>

    <!-- Achievements Grid -->
    <section id="achievementsGrid" class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 mb-12">
      {achievements.map((achievement, index) => (
        <div class={`achievement-card bg-neutral-100 dark:bg-neutral-900 rounded-lg overflow-hidden hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300 border-l-4 ${
          achievement.type === 'publication' ? 'border-blue-500' :
          achievement.type === 'project' ? 'border-green-500' :
          achievement.type === 'achievement' ? 'border-yellow-500' : 'border-purple-500'
        }`} data-category={achievement.type}>
          <!-- Image -->
          <div class="relative h-48 bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-700 dark:to-neutral-800">
            {achievement.image ? (
              <img src={achievement.image} alt={achievement.title} class="w-full h-full object-cover">
            ) : (
              <div class="flex items-center justify-center h-full">
                <i class={`ph ph-${achievement.icon} text-6xl text-neutral-400`}></i>
              </div>
            )}
            <div class="absolute top-4 right-4">
              <span class={`px-3 py-1 rounded-full text-xs font-medium ${
                achievement.type === 'publication' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' :
                achievement.type === 'project' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' :
                achievement.type === 'achievement' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300' :
                'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300'
              }`}>
                {achievement.type === 'publication' ? 'Publication' :
                 achievement.type === 'project' ? 'Projet' :
                 achievement.type === 'achievement' ? 'Récompense' : 'Autre'}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-2 line-clamp-2">
              {achievement.title}
            </h3>
            
            <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-3">
              {achievement.date} • {achievement.journal || achievement.category}
            </p>

            <p class="text-neutral-600 dark:text-neutral-300 text-sm leading-relaxed mb-4 line-clamp-3">
              {achievement.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-4">
              {achievement.tags.slice(0, 3).map(tag => (
                <span class="bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-1 rounded text-xs">
                  {tag}
                </span>
              ))}
              {achievement.tags.length > 3 && (
                <span class="text-neutral-400 text-xs">+{achievement.tags.length - 3}</span>
              )}
            </div>

            <!-- Technologies -->
            {achievement.technologies && achievement.technologies.length > 0 && (
              <div class="mb-4">
                <div class="flex flex-wrap gap-1">
                  {achievement.technologies.slice(0, 4).map(tech => (
                    <span class="bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-300 px-2 py-1 rounded text-xs">
                      {tech}
                    </span>
                  ))}
                  {achievement.technologies.length > 4 && (
                    <span class="text-neutral-400 text-xs">+{achievement.technologies.length - 4}</span>
                  )}
                </div>
              </div>
            )}

            <!-- Action Button -->
            <div class="flex justify-between items-center">
              {achievement.link ? (
                <a href={achievement.link} target="_blank" class="text-green-600 hover:text-green-700 font-medium text-sm flex items-center">
                  <i class="ph ph-external-link mr-1"></i>
                  Voir
                </a>
              ) : (
                <span class="text-neutral-400 text-sm">Projet interne</span>
              )}
              <span class="text-xs text-neutral-500">{achievement.date}</span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Pagination -->
    <section class="flex justify-center">
      <div class="flex gap-2">
        {Array.from({ length: totalPages }, (_, i) => (
          <button onclick={`showPage(${i + 1})`} class={`page-btn px-4 py-2 rounded-lg font-medium transition-all ${
            i === 0 ? 'bg-green-600 text-white' : 'bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-green-500 hover:text-white'
          }`}>
            {i + 1}
          </button>
        ))}
      </div>
    </section>

    <!-- Stats Summary -->
    <section class="mt-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-chart-line mr-3 text-green-500"></i>
        Résumé des Réalisations
      </h2>
      
      <div class="grid md:grid-cols-4 gap-6">
        <div class="stat-card bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">2</div>
          <div class="text-sm opacity-90">Publications</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-green-500 to-green-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">2</div>
          <div class="text-sm opacity-90">Dashboards</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">2</div>
          <div class="text-sm opacity-90">Rapports</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">4</div>
          <div class="text-sm opacity-90">Récompenses</div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  let currentPage = 1;
  let currentFilter = 'all';

  document.addEventListener('astro:page-load', () => {
    // Animation observer for achievement cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe achievement cards
    const achievementCards = document.querySelectorAll('.achievement-card');
    achievementCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });

  function filterAchievements(category) {
    currentFilter = category;
    currentPage = 1;
    
    // Update filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.classList.remove('active', 'bg-green-600', 'text-white');
      btn.classList.add('bg-neutral-200', 'dark:bg-neutral-700', 'text-neutral-700', 'dark:text-neutral-300');
    });
    
    event.target.classList.add('active', 'bg-green-600', 'text-white');
    event.target.classList.remove('bg-neutral-200', 'dark:bg-neutral-700', 'text-neutral-700', 'dark:text-neutral-300');
    
    // Filter cards
    const cards = document.querySelectorAll('.achievement-card');
    cards.forEach(card => {
      if (category === 'all' || card.dataset.category === category) {
        card.style.display = 'block';
        card.classList.add('animate-fade-in');
      } else {
        card.style.display = 'none';
        card.classList.remove('animate-fade-in');
      }
    });
    
    // Update pagination
    updatePagination();
  }

  function showPage(page) {
    currentPage = page;
    
    // Update page buttons
    document.querySelectorAll('.page-btn').forEach((btn, index) => {
      if (index + 1 === page) {
        btn.classList.add('bg-green-600', 'text-white');
        btn.classList.remove('bg-neutral-200', 'dark:bg-neutral-700', 'text-neutral-700', 'dark:text-neutral-300');
      } else {
        btn.classList.remove('bg-green-600', 'text-white');
        btn.classList.add('bg-neutral-200', 'dark:bg-neutral-700', 'text-neutral-700', 'dark:text-neutral-300');
      }
    });
    
    // Show/hide cards based on page
    const cards = document.querySelectorAll('.achievement-card');
    const startIndex = (page - 1) * 6;
    const endIndex = startIndex + 6;
    
    cards.forEach((card, index) => {
      if (index >= startIndex && index < endIndex) {
        card.style.display = 'block';
        card.classList.add('animate-fade-in');
      } else {
        card.style.display = 'none';
        card.classList.remove('animate-fade-in');
      }
    });
  }

  function updatePagination() {
    // This would update pagination based on filtered results
    // For now, we'll keep it simple
  }
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .achievement-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>