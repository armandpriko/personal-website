---

<MainLayout title="Expérience Professionnelle - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-6xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Expérience Professionnelle
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Mon parcours en Data Science, Machine Learning et Agriculture de précision
      </p>
    </section>

    <!-- Timeline Section -->
    <section class="relative">
      <!-- Timeline Line -->
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-green-500 to-blue-600"></div>
      
      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class="experience-item relative flex items-start">
            <!-- Timeline Dot -->
            <div class={`absolute left-6 w-4 h-4 rounded-full border-4 border-white dark:border-neutral-900 z-10 ${
              exp.status === 'current' ? 'bg-green-500' : 'bg-blue-500'
            }`}></div>
            
            <!-- Content -->
            <div class="ml-16 bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6 w-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300">
              <!-- Header -->
              <div class="flex justify-between items-start mb-4">
                <div class="flex items-start">
                  <div class={`bg-gradient-to-br ${
                    exp.status === 'current' ? 'from-green-500 to-green-600' : 'from-blue-500 to-blue-600'
                  } p-3 rounded-lg mr-4`}>
                    <i class={`ph ph-${exp.icon} text-2xl text-white`}></i>
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-1">
                      {exp.title}
                    </h3>
                    <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-1">{exp.company}</p>
                    <p class="text-sm text-neutral-500 mb-2">{exp.location}</p>
                    <div class="flex gap-2">
                      <span class={`px-3 py-1 rounded-full text-xs font-medium ${
                        exp.status === 'current' ? 'bg-green-900 text-green-300' : 'bg-blue-900 text-blue-300'
                      }`}>
                        {exp.type}
                      </span>
                      <span class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-700 text-neutral-300">
                        {exp.duration}
                      </span>
                    </div>
                  </div>
                </div>
                <span class="text-sm text-neutral-500 font-medium">{exp.period}</span>
              </div>

              <!-- Description -->
              <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
                {exp.description}
              </p>

              <!-- Responsibilities -->
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-3 flex items-center">
                  <i class="ph ph-list-checks mr-2 text-green-500"></i>
                  Responsabilités principales
                </h4>
                <ul class="space-y-2">
                  {exp.responsibilities.map(responsibility => (
                    <li class="flex items-start text-neutral-600 dark:text-neutral-300">
                      <i class="ph ph-check text-green-500 mr-2 mt-1 flex-shrink-0"></i>
                      <span>{responsibility}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Technologies -->
              <div class="mb-4">
                <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-3 flex items-center">
                  <i class="ph ph-wrench mr-2 text-blue-500"></i>
                  Technologies utilisées
                </h4>
                <div class="flex flex-wrap gap-2">
                  {exp.technologies.map(tech => (
                    <span class="bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-3 py-1 rounded-full text-sm">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Achievements -->
              <div class="bg-neutral-200 dark:bg-neutral-800 p-4 rounded-lg">
                <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-3 flex items-center">
                  <i class="ph ph-trophy mr-2 text-yellow-500"></i>
                  Réalisations clés
                </h4>
                <ul class="space-y-1">
                  {exp.achievements.map(achievement => (
                    <li class="flex items-start text-neutral-600 dark:text-neutral-300">
                      <i class="ph ph-star text-yellow-500 mr-2 mt-1 flex-shrink-0"></i>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Evolution Section -->
    <section class="mt-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-chart-line mr-3 text-green-500"></i>
        Évolution des compétences
      </h2>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="skill-evolution bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6">
          <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-4 flex items-center">
            <i class="ph ph-code mr-2 text-green-500"></i>
            Programmation & ML
          </h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Python</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 95%"></div>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Machine Learning</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 90%"></div>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Deep Learning</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 85%"></div>
              </div>
            </div>
          </div>
        </div>


        <div class="skill-evolution bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6">
          <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-4 flex items-center">
            <i class="ph ph-leaf mr-2 text-green-500"></i>
            Agriculture & Environnement
          </h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Remote Sensing</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 92%"></div>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Soil Analysis</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 88%"></div>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-600 dark:text-neutral-300">Conservation</span>
              <div class="w-24 bg-neutral-300 dark:bg-neutral-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 85%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer for experience items
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe experience items
    const experienceItems = document.querySelectorAll('.experience-item');
    experienceItems.forEach(item => {
      item.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(item);
    });

    // Observe skill evolution cards
    const skillCards = document.querySelectorAll('.skill-evolution');
    skillCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .experience-item:hover {
    transform: translateX(5px);
    transition: transform 0.3s ease;
  }
</style>
