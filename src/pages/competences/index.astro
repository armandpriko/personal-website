---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';

const skillCategories = [
  {
    name: 'Data Science & Machine Learning',
    icon: 'brain',
    color: 'text-blue-500',
    skills: [
      { name: 'Python', level: 'Avancé', icon: 'code' },
      { name: 'Machine Learning', level: 'Expert', icon: 'chart-line' },
      { name: 'Deep Learning', level: 'Intermédiaire', icon: 'neural-network' },
      { name: 'Analyse statistique', level: 'Avancé', icon: 'graph' }
    ]
  },
  {
    name: 'Analyse Géospatiale',
    icon: 'map-pin',
    color: 'text-green-500',
    skills: [
      { name: 'QGIS', level: 'Expert', icon: 'map' },
      { name: 'GeoPandas', level: 'Avancé', icon: 'map-trifold' },
      { name: 'Imagerie satellite', level: 'Intermédiaire', icon: 'satellite' },
      { name: 'Cartographie', level: 'Expert', icon: 'compass' }
    ]
  },
  {
    name: 'Technologies & Outils',
    icon: 'wrench',
    color: 'text-purple-500',
    skills: [
      { name: 'Docker', level: 'Intermédiaire', icon: 'docker-logo' },
      { name: 'Git', level: 'Avancé', icon: 'github-logo' },
      { name: 'Linux', level: 'Intermédiaire', icon: 'linux-logo' },
      { name: 'SQL & NoSQL', level: 'Avancé', icon: 'database' }
    ]
  },
  {
    name: 'Développement Web',
    icon: 'code',
    color: 'text-red-500',
    skills: [
      { name: 'Tailwind CSS', level: 'Expert', icon: 'css-logo' },
      { name: 'React', level: 'Intermédiaire', icon: 'react-logo' },
      { name: 'Astro', level: 'Avancé', icon: 'rocket' },
      { name: 'JavaScript', level: 'Avancé', icon: 'javascript-logo' }
    ]
  }
];
---

<MainLayout title="Compétences - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-4xl space-y-12">
    <section>
      <h1 class="text-4xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Mes Compétences
      </h1>
      
      <div class="grid md:grid-cols-2 gap-6">
        {skillCategories.map(category => (
          <div class="bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6 shadow-md dark:shadow-none">
            <div class="flex items-center mb-6 border-b border-neutral-200 dark:border-neutral-800 pb-3">
              <i class={`ph ph-${category.icon} text-3xl ${category.color} mr-4`}></i>
              <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
                {category.name}
              </h2>
            </div>
            <div class="space-y-4">
              {category.skills.map(skill => (
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-3">
                    <i class={`ph ph-${skill.icon} text-xl text-neutral-600 dark:text-neutral-400`}></i>
                    <span class="text-neutral-700 dark:text-neutral-300">{skill.name}</span>
                  </div>
                  <span class={`text-sm font-semibold ${
                    skill.level === 'Expert' ? 'text-green-600' : 
                    skill.level === 'Avancé' ? 'text-blue-600' : 
                    'text-yellow-600'
                  }`}>
                    {skill.level}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      
      <div class="mt-12 bg-neutral-100 dark:bg-neutral-900 rounded-lg p-6 shadow-md dark:shadow-none">
        <h2 class="text-2xl font-semibold mb-6 text-neutral-900 dark:text-neutral-100 border-b border-neutral-200 dark:border-neutral-800 pb-3">
          <i class="ph ph-target mr-2 text-orange-500"></i>Objectifs de Développement
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="flex items-start space-x-3">
            <i class="ph ph-rocket text-2xl text-blue-500 mt-1"></i>
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Intelligence Artificielle</h3>
              <p class="text-neutral-600 dark:text-neutral-300 text-sm">Approfondir mes compétences en IA générative</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <i class="ph ph-cloud text-2xl text-green-500 mt-1"></i>
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Cloud Computing</h3>
              <p class="text-neutral-600 dark:text-neutral-300 text-sm">Certification AWS et Azure</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('section > div, section > div > div');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    sections.forEach(section => {
      section.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(section);
    });
  });
</script>
