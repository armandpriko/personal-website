---
import MainLayout from '../../layouts/MainLayout.astro';
import { Icon } from '@phosphor-icons/react';

const certifications = [
  {
    title: "Drone Pilot (A1/A2/A3)",
    issuer: "Certification Nationale",
    date: "2024",
    icon: "drone"
  },
  {
    title: "Nanodegree AI/ML Engineering",
    issuer: "AWS-Udacity",
    date: "2023",
    icon: "graduation-cap"
  }
];
---

<MainLayout title="Certifications - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-4xl">
    <section>
      <h1 class="text-4xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600">
        Mes Certifications
      </h1>
      <div class="grid md:grid-cols-2 gap-6">
        {certifications.map(cert => (
          <div class="bg-neutral-900 rounded-lg p-6 hover:bg-neutral-800 transition-colors group">
            <div class="flex items-center mb-4">
              <Icon name={cert.icon} class="w-10 h-10 text-blue-500 mr-4" />
              <h2 class="text-2xl font-semibold text-neutral-100">{cert.title}</h2>
            </div>
            <div class="text-neutral-300">
              <p>{cert.issuer}</p>
              <p class="text-sm text-neutral-400">{cert.date}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</MainLayout>
