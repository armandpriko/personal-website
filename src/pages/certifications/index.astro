---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';

const certifications = [
  {
    title: "Nanodegree en AI/ML avec Python",
    issuer: "AWS/Udacity",
    date: "Février 2024",
    icon: "brain",
    description: "Formation intensive en intelligence artificielle et machine learning avec Python, couvrant les algorithmes de deep learning, la computer vision et le traitement du langage naturel."
  },
  {
    title: "Télépilote de drone certifié (A1/A2/A3)",
    issuer: "Agence européenne de la sécurité aérienne",
    date: "Mai 2023",
    icon: "drone",
    description: "Certification européenne pour le pilotage de drones civils dans les catégories A1, A2 et A3, autorisant les vols en agglomération et hors agglomération."
  },
  {
    title: "Certificat en conservation des aires protégées",
    issuer: "Université Senghor / UICN PAPACO",
    date: "Février 2023 - Juillet 2023",
    icon: "tree",
    description: "Formation spécialisée en conservation de la biodiversité et gestion des aires protégées, avec mention. Programme de 15 ECTS couvrant les aspects écologiques, sociaux et économiques de la conservation."
  }
];
---

<MainLayout title="Certifications - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-6xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Mes Certifications
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Formations et certifications professionnelles dans le domaine de la Data Science et de l'Agriculture
      </p>
    </section>

    <!-- Certifications Grid -->
    <section class="grid lg:grid-cols-1 gap-8">
      {certifications.map((cert, index) => (
        <div class="certification-card bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300 border-l-4 border-blue-500">
          <!-- Certification Header -->
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-blue-500 to-purple-600 p-4 rounded-lg mr-6">
                <i class={`ph ph-${cert.icon} text-3xl text-white`}></i>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                  {cert.title}
                </h3>
                <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-1">{cert.issuer}</p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">{cert.date}</p>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Certifié
              </span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {cert.description}
          </p>
        </div>
      ))}
    </section>

    <!-- Skills Summary -->
    <section class="mt-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-chart-line mr-3 text-green-500"></i>
        Compétences Certifiées
      </h2>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="stat-card bg-gradient-to-br from-green-500 to-green-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">AI/ML</div>
          <div class="text-sm opacity-90">Machine Learning & Deep Learning</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Drone</div>
          <div class="text-sm opacity-90">Télépilotage & Cartographie</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Conservation</div>
          <div class="text-sm opacity-90">Biodiversité & Aires Protégées</div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer for certification cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe certification cards
    const certificationCards = document.querySelectorAll('.certification-card');
    certificationCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .certification-card:hover {
    transform: translateX(5px);
    transition: transform 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }
</style>
