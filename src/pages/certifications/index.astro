        </div>
        <div class="stat-card bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Drone</div>
          <div class="text-sm opacity-90">Télépilotage & Cartographie</div>
        </div>

        <div class="stat-card bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Conservation</div>
          <div class="text-sm opacity-90">Biodiversité & Aires Protégées</div>
        </div>
        
        <div class="stat-card bg-gradient-to-br from-yellow-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Agriculture</div>
          <div class="text-sm opacity-90">Biodiversité & Aires Protégées</div>
        </div>

      </div>
    </section>
  </main>

  <!-- PDF Viewer Modal -->
  <div id="pdfModal" class="fixed inset-0 bg-black bg-opacity-75 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-neutral-900 rounded-lg max-w-4xl w-full max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex justify-between items-center p-6 border-b border-neutral-200 dark:border-neutral-700">
        <h3 id="pdfModalTitle" class="text-xl font-semibold text-neutral-900 dark:text-neutral-100"></h3>
        <button onclick="closePDFViewer()" class="text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200">
          <i class="ph ph-x text-2xl"></i>
        </button>
      </div>
      
      <!-- PDF Container -->
      <div class="flex-1 p-6 overflow-auto">
        <div class="relative">
          <div id="pdfContainer" class="w-full h-96 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <div class="text-center">
              <i class="ph ph-file-pdf text-6xl text-red-500 mb-4"></i>
              <p class="text-neutral-600 dark:text-neutral-300">Chargement du certificat...</p>
            </div>
          </div>
          
          <!-- Security Notice -->
          <div class="mt-4 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
            <div class="flex items-center">
              <i class="ph ph-warning text-yellow-600 dark:text-yellow-400 mr-2"></i>
              <p class="text-sm text-yellow-800 dark:text-yellow-200">
                <strong>Note de sécurité :</strong> Ce certificat est affiché en mode lecture seule. Le téléchargement et l'impression sont désactivés pour protéger l'intégrité du document.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer for certification cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe certification cards
    const certificationCards = document.querySelectorAll('.certification-card');
    certificationCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });

  // Image Viewer Functions
  function openImageViewer(imageUrl, title) {
    const modal = document.getElementById('pdfModal');
    const titleElement = document.getElementById('pdfModalTitle');
    const container = document.getElementById('pdfContainer');
    
    titleElement.textContent = title;
    
    // Create image viewer
    container.innerHTML = `
      <div class="w-full h-full relative">
        <img src="${imageUrl}" alt="${title}" class="w-full h-full object-contain rounded-lg">
        
        <!-- Overlay to prevent interaction -->
        <div class="absolute inset-0 bg-transparent" 
             oncontextmenu="return false;"
             onselectstart="return false;"
             ondragstart="return false;">
        </div>
      </div>
    `;
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Disable right-click, copy, print, etc.
    disablePDFInteractions();
  }

  // PDF Viewer Functions
  function openPDFViewer(pdfUrl, title) {
    const modal = document.getElementById('pdfModal');
    const titleElement = document.getElementById('pdfModalTitle');
    const container = document.getElementById('pdfContainer');
    
    titleElement.textContent = title;
    
    // Create secure PDF viewer
    container.innerHTML = `
      <div class="w-full h-full relative">
        <iframe 
          src="${pdfUrl}#toolbar=0&navpanes=0&scrollbar=0&statusbar=0&messages=0&scrollbar=0&view=FitH"
          class="w-full h-full border-0"
          style="pointer-events: none;"
          oncontextmenu="return false;"
          onselectstart="return false;"
          ondragstart="return false;"
          onkeydown="return false;">
        </iframe>
        
        <!-- Overlay to prevent interaction -->
        <div class="absolute inset-0 bg-transparent" 
             oncontextmenu="return false;"
             onselectstart="return false;"
             ondragstart="return false;"
             onkeydown="return false;">
        </div>
      </div>
    `;
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Disable right-click, copy, print, etc.
    disablePDFInteractions();
  }

  function closePDFViewer() {
    const modal = document.getElementById('pdfModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    enablePDFInteractions();
  }

  function disablePDFInteractions() {
    // Disable right-click
    document.addEventListener('contextmenu', preventDefault);
    
    // Disable keyboard shortcuts
    document.addEventListener('keydown', disableKeyboardShortcuts);
    
    // Disable text selection
    document.addEventListener('selectstart', preventDefault);
    
    // Disable drag
    document.addEventListener('dragstart', preventDefault);
  }

  function enablePDFInteractions() {
    document.removeEventListener('contextmenu', preventDefault);
    document.removeEventListener('keydown', disableKeyboardShortcuts);
    document.removeEventListener('selectstart', preventDefault);
    document.removeEventListener('dragstart', preventDefault);
  }

  function preventDefault(e) {
    e.preventDefault();
    return false;
  }

  function disableKeyboardShortcuts(e) {
    // Disable common shortcuts
    const forbiddenKeys = [
      'F12', // Developer tools
      'Ctrl+s', 'Cmd+s', // Save
      'Ctrl+p', 'Cmd+p', // Print
      'Ctrl+a', 'Cmd+a', // Select all
      'Ctrl+c', 'Cmd+c', // Copy
      'Ctrl+v', 'Cmd+v', // Paste
      'Ctrl+x', 'Cmd+x', // Cut
      'Ctrl+z', 'Cmd+z', // Undo
      'Ctrl+y', 'Cmd+y', // Redo
    ];
    
    const key = e.key;
    const isCtrl = e.ctrlKey || e.metaKey;
    
    if (key === 'F12' || 
        (isCtrl && (key === 's' || key === 'p' || key === 'a' || 
                   key === 'c' || key === 'v' || key === 'x' || 
                   key === 'z' || key === 'y'))) {
      e.preventDefault();
      return false;
    }
  }

  // Close modal when clicking outside
  document.addEventListener('click', (e) => {
    const modal = document.getElementById('pdfModal');
    if (e.target === modal) {
      closePDFViewer();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('pdfModal');
      if (!modal.classList.contains('hidden')) {
        closePDFViewer();
      }
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .certification-card:hover {
    transform: translateX(5px);
    transition: transform 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }
</style>
