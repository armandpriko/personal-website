---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';

const certifications = [
  {
    title: "Microsoft Learn Location Mention Recognition Challenge",
    issuer: "Zindi & Microsoft",
    date: "13 Octobre 2024",
    icon: "map-pin",
    description: "Certification pour la participation au challenge de reconnaissance automatique de mentions de lieux dans les posts de microblogging lors d'urgences. Challenge organisé par Microsoft et HBKU.",
    pdfUrl: "/certificates/zindi-location-recognition-certificate.pdf",
    rank: "77/320 (Top 25%)",
    score: "77/300",
    challenge: "Microsoft Learn Location Mention Recognition",
    question: "Can you identify locations in a tweet?",
    skills: ["Natural Language Processing", "Generative AI"],
    prize: "$5,000 USD pool"
  },
  {
    title: "Togo Fiber Optics Uptake Prediction Challenge",
    issuer: "Zindi & Ministère Économie Numérique Togo",
    date: "23 Juin 2024",
    icon: "wifi-high",
    description: "Certification pour la participation au challenge de prédiction d'adoption de la fibre optique au Togo. Challenge organisé par le Ministère de l'Économie Numérique et de la Transformation du Togo.",
    pdfUrl: "/certificates/zindi-fiber-optics-certificate.pdf",
    rank: "30/93 (Top 50%)",
    score: "30/90",
    challenge: "Togo Fiber Optics Uptake Prediction Challenge",
    question: "Can you predict which households and businesses will have fiber optics access?",
    skills: ["Prediction", "Telecom"],
    prize: "3,000,000 XOF pool"
  },
  {
    title: "Télépilote de drone certifié (A1/A2/A3)",
    issuer: "Agence européenne de la sécurité aérienne",
    date: "Mai 2023",
    icon: "drone",
    description: "Certification européenne pour le pilotage de drones civils dans les catégories A1, A2 et A3, autorisant les vols en agglomération et hors agglomération.",
    pdfUrl: null,
    rank: null,
    score: null,
    challenge: null,
    question: null,
    skills: ["Drone Piloting", "Aerial Photography", "Remote Sensing"],
    prize: null
  },
  {
    title: "Certificat en conservation des aires protégées",
    issuer: "Université Senghor / UICN PAPACO",
    date: "Février 2023 - Juillet 2023",
    icon: "tree",
    description: "Formation spécialisée en conservation de la biodiversité et gestion des aires protégées, avec mention. Programme de 15 ECTS couvrant les aspects écologiques, sociaux et économiques de la conservation.",
    pdfUrl: null,
    rank: null,
    score: null,
    challenge: null,
    question: null,
    skills: ["Biodiversity Conservation", "Protected Areas Management", "Environmental Policy"],
    prize: null
  }
];
---

<MainLayout title="Certifications - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-6xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Mes Certifications
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Formations et certifications professionnelles dans le domaine de la Data Science et de l'Agriculture
      </p>
    </section>

    <!-- Certifications Grid -->
    <section class="grid lg:grid-cols-1 gap-8">
      {certifications.map((cert, index) => (
        <div class="certification-card bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300 border-l-4 border-blue-500">
          <!-- Certification Header -->
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-blue-500 to-purple-600 p-4 rounded-lg mr-6">
                <i class={`ph ph-${cert.icon} text-3xl text-white`}></i>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                  {cert.title}
                </h3>
                <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-1">{cert.issuer}</p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">{cert.date}</p>
                
                {/* Challenge Details for Zindi Certifications */}
                {cert.challenge && (
                  <div class="mt-3 p-4 bg-neutral-200 dark:bg-neutral-800 rounded-lg">
                    <h4 class="font-semibold text-neutral-900 dark:text-neutral-100 mb-2">{cert.challenge}</h4>
                    <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-3">{cert.question}</p>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                      <div>
                        <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Rang & Score</p>
                        <p class="text-lg font-bold text-green-600 dark:text-green-400">{cert.rank}</p>
                        <p class="text-sm text-neutral-500">Score: {cert.score}</p>
                      </div>
                      <div>
                        <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Prix</p>
                        <p class="text-sm text-yellow-600 dark:text-yellow-400">{cert.prize}</p>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
            <div class="text-right">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Certifié
              </span>
              {cert.pdfUrl && (
                <button onclick={`openPDFViewer('${cert.pdfUrl}', '${cert.title}')`} 
                        class="mt-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                  <i class="ph ph-eye mr-2"></i>
                  Voir le certificat
                </button>
              )}
            </div>
          </div>

          <!-- Description -->
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
            {cert.description}
          </p>

          <!-- Skills -->
          {cert.skills && (
            <div class="flex flex-wrap gap-2">
              {cert.skills.map(skill => (
                <span class="bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-3 py-1 rounded-full text-sm">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </section>

    <!-- Skills Summary -->
    <section class="mt-16">
      <h2 class="text-3xl font-semibold mb-8 text-neutral-100 border-b border-neutral-800 pb-2 flex items-center">
        <i class="ph ph-chart-line mr-3 text-green-500"></i>
        Compétences Certifiées
      </h2>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="stat-card bg-gradient-to-br from-green-500 to-green-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">AI/ML</div>
          <div class="text-sm opacity-90">Machine Learning & Deep Learning</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Drone</div>
          <div class="text-sm opacity-90">Télépilotage & Cartographie</div>
        </div>
        <div class="stat-card bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg p-6 text-center text-white">
          <div class="text-3xl font-bold mb-2">Conservation</div>
          <div class="text-sm opacity-90">Biodiversité & Aires Protégées</div>
        </div>
        
      </div>
    </section>
  </main>

  <!-- PDF Viewer Modal -->
  <div id="pdfModal" class="fixed inset-0 bg-black bg-opacity-75 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-neutral-900 rounded-lg max-w-4xl w-full max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex justify-between items-center p-6 border-b border-neutral-200 dark:border-neutral-700">
        <h3 id="pdfModalTitle" class="text-xl font-semibold text-neutral-900 dark:text-neutral-100"></h3>
        <button onclick="closePDFViewer()" class="text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200">
          <i class="ph ph-x text-2xl"></i>
        </button>
      </div>
      
      <!-- PDF Container -->
      <div class="flex-1 p-6 overflow-auto">
        <div class="relative">
          <div id="pdfContainer" class="w-full h-96 border border-neutral-300 dark:border-neutral-600 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <div class="text-center">
              <i class="ph ph-file-pdf text-6xl text-red-500 mb-4"></i>
              <p class="text-neutral-600 dark:text-neutral-300">Chargement du certificat...</p>
            </div>
          </div>
          
          <!-- Security Notice -->
          <div class="mt-4 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
            <div class="flex items-center">
              <i class="ph ph-warning text-yellow-600 dark:text-yellow-400 mr-2"></i>
              <p class="text-sm text-yellow-800 dark:text-yellow-200">
                <strong>Note de sécurité :</strong> Ce certificat est affiché en mode lecture seule. Le téléchargement et l'impression sont désactivés pour protéger l'intégrité du document.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer for certification cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe certification cards
    const certificationCards = document.querySelectorAll('.certification-card');
    certificationCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });

    // Observe stat cards
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach(card => {
      card.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(card);
    });
  });

  // PDF Viewer Functions
  function openPDFViewer(pdfUrl, title) {
    const modal = document.getElementById('pdfModal');
    const titleElement = document.getElementById('pdfModalTitle');
    const container = document.getElementById('pdfContainer');
    
    titleElement.textContent = title;
    
    // Create secure PDF viewer
    container.innerHTML = `
      <div class="w-full h-full relative">
        <iframe 
          src="${pdfUrl}#toolbar=0&navpanes=0&scrollbar=0&statusbar=0&messages=0&scrollbar=0&view=FitH"
          class="w-full h-full border-0"
          style="pointer-events: none;"
          oncontextmenu="return false;"
          onselectstart="return false;"
          ondragstart="return false;"
          onkeydown="return false;">
        </iframe>
        
        <!-- Overlay to prevent interaction -->
        <div class="absolute inset-0 bg-transparent" 
             oncontextmenu="return false;"
             onselectstart="return false;"
             ondragstart="return false;"
             onkeydown="return false;">
        </div>
      </div>
    `;
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Disable right-click, copy, print, etc.
    disablePDFInteractions();
  }

  function closePDFViewer() {
    const modal = document.getElementById('pdfModal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    enablePDFInteractions();
  }

  function disablePDFInteractions() {
    // Disable right-click
    document.addEventListener('contextmenu', preventDefault);
    
    // Disable keyboard shortcuts
    document.addEventListener('keydown', disableKeyboardShortcuts);
    
    // Disable text selection
    document.addEventListener('selectstart', preventDefault);
    
    // Disable drag
    document.addEventListener('dragstart', preventDefault);
  }

  function enablePDFInteractions() {
    document.removeEventListener('contextmenu', preventDefault);
    document.removeEventListener('keydown', disableKeyboardShortcuts);
    document.removeEventListener('selectstart', preventDefault);
    document.removeEventListener('dragstart', preventDefault);
  }

  function preventDefault(e) {
    e.preventDefault();
    return false;
  }

  function disableKeyboardShortcuts(e) {
    // Disable common shortcuts
    const forbiddenKeys = [
      'F12', // Developer tools
      'Ctrl+s', 'Cmd+s', // Save
      'Ctrl+p', 'Cmd+p', // Print
      'Ctrl+a', 'Cmd+a', // Select all
      'Ctrl+c', 'Cmd+c', // Copy
      'Ctrl+v', 'Cmd+v', // Paste
      'Ctrl+x', 'Cmd+x', // Cut
      'Ctrl+z', 'Cmd+z', // Undo
      'Ctrl+y', 'Cmd+y', // Redo
    ];
    
    const key = e.key;
    const isCtrl = e.ctrlKey || e.metaKey;
    
    if (key === 'F12' || 
        (isCtrl && (key === 's' || key === 'p' || key === 'a' || 
                   key === 'c' || key === 'v' || key === 'x' || 
                   key === 'z' || key === 'y'))) {
      e.preventDefault();
      return false;
    }
  }

  // Close modal when clicking outside
  document.addEventListener('click', (e) => {
    const modal = document.getElementById('pdfModal');
    if (e.target === modal) {
      closePDFViewer();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('pdfModal');
      if (!modal.classList.contains('hidden')) {
        closePDFViewer();
      }
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .certification-card:hover {
    transform: translateX(5px);
    transition: transform 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
  }
</style>
