        Mes Certifications
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Formations et certifications professionnelles dans le domaine de la Data Science et de l'Agriculture
      </p>
    </section>

    <!-- Certifications Grid -->
    <section class="grid lg:grid-cols-1 gap-8">
      {certifications.map((cert, index) => (
        <div class="certification-card bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300 border-l-4 border-blue-500">
          <!-- Certification Header -->
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-start">
              <div class="bg-gradient-to-br from-blue-500 to-purple-600 p-4 rounded-lg mr-6">
                <i class={`ph ph-${cert.icon} text-3xl text-white`}></i>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                  {cert.title}
                </h3>
                <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-1">{cert.issuer}</p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">{cert.date}</p>
                
                {/* Challenge Details for Zindi Certifications */}
                {cert.challenge && (
                  <div class="mt-3 p-4 bg-neutral-200 dark:bg-neutral-800 rounded-lg">
                    <h4 class="font-semibold text-neutral-900 dark:text-neutral-100 mb-2">{cert.challenge}</h4>
                    <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-3">{cert.question}</p>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                      <div>
                        <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Rang & Score</p>
                        <p class="text-lg font-bold text-green-600 dark:text-green-400">{cert.rank}</p>
                        <p class="text-sm text-neutral-500">Score: {cert.score}</p>
                      </div>
                      <div>
                        <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Prix</p>
                        <p class="text-sm text-yellow-600 dark:text-yellow-400">{cert.prize}</p>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
            <div class="text-right">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Certifié
              </span>
              <div class="flex flex-col gap-2">
                {cert.imageUrl && (
                  <button onclick={`openImageViewer('${cert.imageUrl}', '${cert.title.replace(/'/g, "\\'")}')`} 
                          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                    <i class="ph ph-image mr-2"></i>
                    Voir l'image
                  </button>
                )}
                {cert.pdfUrl && (
                  <button onclick={`openPDFViewer('${cert.pdfUrl}', '${cert.title.replace(/'/g, "\\'")}')`} 
                          class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                    <i class="ph ph-eye mr-2"></i>
                    Voir le PDF
                  </button>
                )}
              </div>
            </div>
          </div>

          <!-- Description -->
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
            {cert.description}
          </p>

          <!-- Skills -->
          {cert.skills && (
            <div class="flex flex-wrap gap-2">
              {cert.skills.map(skill => (
                <span class="bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-3 py-1 rounded-full text-sm">
                  {skill}
