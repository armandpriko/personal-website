---
import MainLayout from '../../layouts/MainLayout.astro';
import '@phosphor-icons/web/regular/style.css';
---

<MainLayout title="Contact - Dzudzogbe Prince Armand Koumi">
  <main class="container mx-auto px-4 py-16 max-w-4xl">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600">
        Contactez-moi
      </h1>
      <p class="text-xl text-neutral-300 mb-8">
        Discutons de vos projets en Data Science, Agriculture de précision ou Machine Learning
      </p>
    </section>

    <!-- Contact Information -->
    <section class="grid md:grid-cols-2 gap-12 mb-16">
      <!-- Contact Details -->
      <div class="space-y-8">
        <h2 class="text-3xl font-semibold text-neutral-100 mb-6">Informations de contact</h2>
        
        <div class="contact-item">
          <div class="flex items-center mb-4">
            <div class="bg-gradient-to-br from-green-500 to-blue-600 p-3 rounded-lg mr-4">
              <i class="ph ph-envelope text-2xl text-white"></i>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Email</h3>
              <a href="mailto:koumiprince@gmail.com" class="text-neutral-600 dark:text-neutral-300 hover:text-green-500 transition">
                koumiprince@gmail.com
              </a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="flex items-center mb-4">
            <div class="bg-gradient-to-br from-blue-500 to-purple-600 p-3 rounded-lg mr-4">
              <i class="ph ph-phone text-2xl text-white"></i>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Téléphone</h3>
              <a href="tel:+33602892354" class="text-neutral-600 dark:text-neutral-300 hover:text-blue-500 transition">
                +33 6 02 89 23 54
              </a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="flex items-center mb-4">
            <div class="bg-gradient-to-br from-purple-500 to-pink-600 p-3 rounded-lg mr-4">
              <i class="ph ph-map-pin text-2xl text-white"></i>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Localisation</h3>
              <p class="text-neutral-600 dark:text-neutral-300">Paris, France</p>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">Disponible pour missions internationales</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="contact-item">
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Réseaux sociaux</h3>
          <div class="flex space-x-4">
            <a href="https://www.linkedin.com/in/dzudzogbe-prince-armand-koumi" target="_blank" 
               class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg transition">
              <i class="ph ph-linkedin-logo text-xl"></i>
            </a>
            <a href="https://github.com/armandpriko" target="_blank" 
               class="bg-neutral-700 hover:bg-neutral-800 text-white p-3 rounded-lg transition">
              <i class="ph ph-github-logo text-xl"></i>
            </a>
            <a href="https://www.youtube.com/@Ddexplora" target="_blank" 
               class="bg-red-600 hover:bg-red-700 text-white p-3 rounded-lg transition">
              <i class="ph ph-youtube-logo text-xl"></i>
            </a>
            <a href="https://www.researchgate.net/profile/Dzudzogbe-Koumi-2?ev=hdr_xprf" target="_blank" 
               class="bg-blue-800 hover:bg-blue-900 text-white p-3 rounded-lg transition">
              <i class="ph ph-graduation-cap text-xl"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8">
        <h2 class="text-3xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6">Envoyez-moi un message</h2>
        
        <form class="space-y-6" action="https://formspree.io/f/YOUR_FORM_ID" method="POST" id="contact-form">
          <div>
            <label for="name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
              Nom complet
            </label>
            <input type="text" id="name" name="name" required
                   class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100">
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
              Email
            </label>
            <input type="email" id="email" name="email" required
                   class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100">
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
              Sujet
            </label>
            <select id="subject" name="subject" required
                    class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100">
              <option value="">Sélectionnez un sujet</option>
              <option value="collaboration">Collaboration professionnelle</option>
              <option value="projet">Proposition de projet</option>
              <option value="consultation">Consultation technique</option>
              <option value="formation">Formation / Conférence</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
              Message
            </label>
            <textarea id="message" name="message" rows="5" required
                      placeholder="Décrivez votre projet ou votre demande..."
                      class="w-full px-4 py-3 border border-neutral-300 dark:border-neutral-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100"></textarea>
          </div>

          <button type="submit" 
                  class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition flex items-center justify-center">
            <i class="ph ph-paper-plane mr-2"></i>
            Envoyer le message
          </button>
        </form>
      </div>
    </section>

    <!-- Availability -->
    <section class="bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6 text-center">
        Disponibilités
      </h2>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="bg-green-100 dark:bg-green-900 p-4 rounded-lg mb-4">
            <i class="ph ph-check-circle text-3xl text-green-600 dark:text-green-400"></i>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Consultation</h3>
          <p class="text-neutral-600 dark:text-neutral-300">Disponible pour des consultations techniques en Data Science et Agriculture de précision</p>
        </div>

        <div class="text-center">
          <div class="bg-blue-100 dark:bg-blue-900 p-4 rounded-lg mb-4">
            <i class="ph ph-handshake text-3xl text-blue-600 dark:text-blue-400"></i>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Collaboration</h3>
          <p class="text-neutral-600 dark:text-neutral-300">Ouvert aux collaborations de recherche et projets innovants</p>
        </div>

        <div class="text-center">
          <div class="bg-purple-100 dark:bg-purple-900 p-4 rounded-lg mb-4">
            <i class="ph ph-graduation-cap text-3xl text-purple-600 dark:text-purple-400"></i>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">Formation</h3>
          <p class="text-neutral-600 dark:text-neutral-300">Interventions et formations en Machine Learning et Télédétection</p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Animation observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, { threshold: 0.1 });

    // Observe contact items
    const contactItems = document.querySelectorAll('.contact-item');
    contactItems.forEach(item => {
      item.classList.add('opacity-0', 'transition-all', 'duration-700');
      observer.observe(item);
    });

    // Form submission with Formspree
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitButton = form.querySelector('button[type="submit"]');
        const originalText = submitButton.innerHTML;
        
        // Show loading state
        submitButton.innerHTML = '<i class="ph ph-spinner animate-spin mr-2"></i>Envoi en cours...';
        submitButton.disabled = true;
        
        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          if (response.ok) {
            // Success
            submitButton.innerHTML = '<i class="ph ph-check-circle mr-2"></i>Message envoyé !';
            submitButton.classList.remove('bg-green-600', 'hover:bg-green-700');
            submitButton.classList.add('bg-green-500');
            form.reset();
            
            // Show success message
            showNotification('Message envoyé avec succès ! Je vous répondrai dans les plus brefs délais.', 'success');
          } else {
            throw new Error('Erreur lors de l\'envoi');
          }
        } catch (error) {
          // Error
          submitButton.innerHTML = '<i class="ph ph-warning mr-2"></i>Erreur - Réessayer';
          submitButton.classList.remove('bg-green-600', 'hover:bg-green-700');
          submitButton.classList.add('bg-red-600');
          showNotification('Une erreur est survenue. Veuillez réessayer ou me contacter directement.', 'error');
        } finally {
          // Reset button after 3 seconds
          setTimeout(() => {
            submitButton.innerHTML = originalText;
            submitButton.disabled = false;
            submitButton.classList.remove('bg-green-500', 'bg-red-600');
            submitButton.classList.add('bg-green-600', 'hover:bg-green-700');
          }, 3000);
        }
      });
    }
    
    // Notification function
    function showNotification(message, type) {
      const notification = document.createElement('div');
      notification.className = `fixed top-20 right-4 z-50 p-4 rounded-lg shadow-lg max-w-sm ${
        type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
      }`;
      notification.innerHTML = `
        <div class="flex items-center">
          <i class="ph ph-${type === 'success' ? 'check-circle' : 'warning-circle'} mr-2"></i>
          <span>${message}</span>
        </div>
      `;
      
      document.body.appendChild(notification);
      
      // Auto remove after 5 seconds
      setTimeout(() => {
        notification.remove();
      }, 5000);
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .contact-item:hover {
    transform: translateX(5px);
    transition: transform 0.3s ease;
  }
</style>